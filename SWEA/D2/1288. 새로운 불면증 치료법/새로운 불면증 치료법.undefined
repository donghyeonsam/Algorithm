T = int(input())
 
for tc in range(1, T+1):
 
    N = int(input())
 
    target = 1023
    mask = 0
    idx = 0
 
    while mask != target:
 
        idx += 1
        num = N * idx
 
        for digit in str(num):
            d = int(digit)
            mask |= (1 << d)
 
 
    print(f'#{tc} {idx*N}')