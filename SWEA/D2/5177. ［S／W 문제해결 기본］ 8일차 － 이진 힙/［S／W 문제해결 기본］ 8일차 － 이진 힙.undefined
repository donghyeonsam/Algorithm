import heapq

T = int(input())

for tc in range(1, T+1):

    n = int(input())
    arr = list(map(int, input().split()))
    min_heap = []
    result = 0

    for i in arr:
        heapq.heappush(min_heap, i)

    m = n - 1
    while m > 0:
        m = (m - 1) // 2
        result += min_heap[m]

    print(f'#{tc} {result}')