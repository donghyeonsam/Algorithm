def inoreder_traversal(i):
    global cnt

    if i > n:
        return
    else:
        inoreder_traversal(i*2)
        bin_tree[i] = cnt
        cnt += 1
        inoreder_traversal(i*2+1)

T = int(input())

for tc in range(1, T+1):

     n = int(input())
     bin_tree = [0] * (n+1)
     cnt = 1
     inoreder_traversal(1)

     print(f'#{tc} {bin_tree[1]} {bin_tree[n//2]}')