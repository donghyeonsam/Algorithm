from collections import deque

def BFS(S):

    global result

    visited = [False] * (N+1)
    q = deque()
    q.append((S, visited))
    visited[S] = True
    while q:
        cur, tmp = q.popleft()

        if cur == G:
            result += 1

        for idx in range(len(graph[cur])):
            if not tmp[graph[cur][idx]]:
                new_tmp = tmp.copy()
                new_tmp[graph[cur][idx]] = True
                q.append((graph[cur][idx], new_tmp))

T = int(input())

for tc in range(1, T+1):

    N, E = map(int, input().split())
    lst = list(map(int, input().split()))
    S, G = map(int, input().split())
    graph = [[] for _ in range(N+1)]
    result = 0

    for idx in range(0, len(lst), 2):
        graph[lst[idx]].append(lst[idx+1])

    BFS(S)

    print(f'#{tc} {result}')