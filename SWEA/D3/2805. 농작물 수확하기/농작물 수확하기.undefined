T = int(input())

for tc in range(1, T+1):

    n = int(input())
    farm_list = [list(map(int, input())) for _ in range(n)]
    f_sum = 0

    if n == 1:
        f_sum += farm_list[0][0]
    elif n > 1:
        mid = n//2

        for i in range(n):
            if i <= mid:
                start = mid - i
                end = mid + i
            else:
                start = i - mid
                end = n - i + mid - 1

            for k in range(start, end + 1):
                f_sum += farm_list[i][k]

    print(f'#{tc} {f_sum}')