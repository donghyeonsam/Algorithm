T = int(input())

for tc in range(1, T+1):

    a, b, c = list(map(int, input().split()))
    cnt = 0

    if a < 1 or b < 2 or c < 3:
        print(f'#{tc} {-1}')
        continue

    while True:
        if a < b and b < c:
            break
        while a >= b:
            a -= 1
            cnt += 1
        while b >= c:
            b -= 1
            cnt += 1

    print(f'#{tc} {cnt}')