def enq(tmp):

    global heap

    heap.append(tmp)
    l = len(heap) - 1

    while l > 1:
        parent = l // 2

        if heap[parent] < heap[l]:
            heap[parent], heap[l] = heap[l], heap[parent]
            l = parent
        else:
            break

def deq():

    if len(heap) == 1:
        return -1

    root = heap[1]
    heap[1] = heap[len(heap) - 1]
    heap.pop()

    k = 1
    size = len(heap)

    while True:
        left = k * 2
        right = k * 2 + 1
        largest = k

        if left < size and heap[left] > heap[largest]:
            largest = left
        if right < size and heap[right] > heap[largest]:
            largest = right

        if largest == k:
            break

        heap[k], heap[largest] = heap[largest], heap[k]
        k = largest

    return root

T = int(input())

for tc in range(1, T+1):

    N = int(input())
    arr = [list(map(int, input().split())) for _ in range(N)]
    heap = [0]
    result = []

    for idx in range(N):
        if arr[idx][0] == 1:
            enq(arr[idx][1])
        else:
            result.append(deq())

    print(f'#{tc}', end=' ')
    print(*result)