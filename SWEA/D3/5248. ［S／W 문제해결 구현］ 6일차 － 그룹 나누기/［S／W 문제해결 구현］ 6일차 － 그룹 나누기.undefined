from collections import deque

def BFS(idx):

    global used, result
    q = deque()
    if not used[idx]:
        q.append(idx)
    while q:
        tmp = q.popleft()
        used[tmp] = True
        for i in range(len(graph[tmp])):
            if not used[graph[tmp][i]]:
                q.append(graph[tmp][i])

    result += 1
    return

T = int(input())

for tc in range(1, T+1):

    N, M = map(int, input().split())
    lst = list(map(int, input().split()))
    graph = [[] for _ in range(N+1)]
    used = [False] * (N+1)
    result = 0

    for idx in range(0, M*2, 2):
        graph[lst[idx]].append(lst[idx+1])
        graph[lst[idx+1]].append(lst[idx])


    for k in range(N+1):
        if graph[k] and not used[k]:
            BFS(k)

    for i in range(1, N+1):
        if not used[i]:
            result += 1

    print(f'#{tc} {result}')