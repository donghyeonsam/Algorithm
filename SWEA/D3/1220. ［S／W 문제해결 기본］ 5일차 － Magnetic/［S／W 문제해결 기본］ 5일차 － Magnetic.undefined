T = 10

for tc in range(1, T + 1):

    n = int(input())
    table_list = [list(map(int, input().split())) for _ in range(n)]
    r_sum = 0

    for col in range(100):
        row = 0
        while row < 100:
            if table_list[row][col] == 1:
                found = False
                row_2 = 1
                while row + row_2 < 100:
                    if table_list[row + row_2][col] == 2:
                        r_sum += 1
                        row = row + row_2 + 1
                        found = True
                        break
                    row_2 += 1
                if not found:
                    row += 1
            else:
                row += 1

    print(f'#{tc} {r_sum}')
