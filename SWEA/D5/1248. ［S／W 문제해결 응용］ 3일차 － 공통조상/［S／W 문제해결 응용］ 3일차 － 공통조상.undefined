from collections import deque
 
def find_root(node):
 
    root_lst = []
    q = deque()
    q.append(node)
    while q:
        cur_node = q.popleft()
        if reverse_graph[cur_node]:
            root = reverse_graph[cur_node][0]
            root_lst.append(root)
            q.append(reverse_graph[cur_node][0])
 
    return root_lst
 
def BFS(node):
 
    cnt = 0
    q = deque()
    q.append(node)
 
    while q:
        cur_node = q.popleft()
        cnt += 1
        for idx in range(len(graph[cur_node])):
            next_node = graph[cur_node][idx]
            q.append(next_node)
 
    return cnt
 
T = int(input())
 
for tc in range(1, T+1):
 
    V, E, node_a, node_b = map(int, input().split())
    lst = list(map(int, input().split()))
    graph = [[] for _ in range(V+1)]
    reverse_graph = [[] for _ in range(V+1)]
    same_root = 0
 
    for k in range(0, 2*E, 2):
        graph[lst[k]].append(lst[k+1])
        reverse_graph[lst[k+1]].append(lst[k])
 
    a_root = find_root(node_a)
    b_root = find_root(node_b)
 
    find = False
    for i in range(len(a_root)):
        for j in range(len(b_root)):
            if a_root[i] == b_root[j]:
                same_root = a_root[i]
                find = True
                break
        if find:
            break
 
    size = BFS(same_root)
 
    print(f'#{tc} {same_root} {size}')