from itertools import combinations

T = int(input())

for tc in range(1, T+1):

    N, B = list(map(int, input().split()))
    arr = list(map(int, input().split()))
    result = 0xffffffffff

    for idx in range(N+1):
        for comb in combinations(arr, idx):
            if sum(comb) >= B:
                result = min(sum(comb), result)

    print(f'#{tc} {result-B}')