import heapq

def Dijkstra(start, graph):

    global cost_map

    pq = []
    dist = [-1] * (N+1)
    dist[start] = 0
    heapq.heappush(pq, (0, start))
    while pq:
        cost, node = heapq.heappop(pq)

        if dist[node] < cost:
            continue

        for k in range(len(graph[node])):
            next_node = graph[node][k][0]
            new_cost = cost + graph[node][k][1]
            if dist[next_node] == -1 or dist[next_node] > new_cost:
                dist[next_node] = new_cost
                heapq.heappush(pq, (new_cost, next_node))

    return dist

T = int(input())

for tc in range(1, T+1):

    N, M, X = map(int, input().split())
    graph = [[] for _ in range(N+1)]
    reverse_graph = [[] for _ in range(N+1)]
    result = 0

    for _ in range(M):
        u, v, w = map(int, input().split())
        graph[u].append((v, w))
        reverse_graph[v].append((u, w))

    dist_from = Dijkstra(X, graph)
    dist_to = Dijkstra(X, reverse_graph)

    for i in range(1, N+1):
        result = max(result, dist_to[i] + dist_from[i])

    print(f'#{tc} {result}')