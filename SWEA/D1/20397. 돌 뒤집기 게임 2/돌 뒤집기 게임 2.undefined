T = int(input())

for tc in range(1, T+1):

    n, m = map(int, input().split())
    stone_list = list(map(int, input().split()))
    ij_list = [list(map(int, input().split())) for _ in range(m)]

    for i in range(m):
        for k in range(1, ij_list[i][1] + 1):
            if 0 <= ij_list[i][0] - k - 1  and ij_list[i][0] + k - 1 < len(stone_list):
                if stone_list[ij_list[i][0] - k - 1] == stone_list[ij_list[i][0] + k - 1]:
                    if stone_list[ij_list[i][0] - k - 1] == 0:
                        stone_list[ij_list[i][0] - k - 1] = 1
                        stone_list[ij_list[i][0] + k - 1] = 1
                    elif stone_list[ij_list[i][0] - k - 1] == 1:
                        stone_list[ij_list[i][0] - k - 1] = 0
                        stone_list[ij_list[i][0] + k - 1] = 0

    print(f'#{tc}', *stone_list)